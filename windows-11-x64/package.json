{
  "name": "ideas-studio-for-openchamber",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Ideas Studio for OpenChamber v2 - study materials and documents development build",
  "license": "Apache-2.0",
  "studioPlatform": {
    "os": "win32",
    "arch": "x64"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.1.1"
    },
    "contributes": {
      "panel": {
        "id": "ideas-studio-v2",
        "name": "Ideas Studio",
        "icon": "panel/icon.svg",
        "entry": "panel/index.html"
      },
      "page": true,
      "capabilities": [
        "files"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  }
}
